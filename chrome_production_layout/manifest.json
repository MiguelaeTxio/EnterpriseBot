{
  "manifest_version": 3,
  "name": "Disposición PRODUCCIÓN",
  "version": "1.3.0",
  "description": "Guarda el grupo de pestañas PRODUCCIÓN con sus vistas divididas y lo abre con un clic; solo con sesión iniciada en Chrome, y al cerrarla borra las sesiones de los sitios.",
  "minimum_chrome_version": "155",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "identity",
    "identity.email",
    "browsingData"
  ],
  "action": {
    "default_title": "Disposición PRODUCCIÓN",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
